+class BlackwellDualStreamRunner:
+    """Python-level orchestrator that runs dQ and dK/dV concurrently on two side streams.
+
+    FA4 uses TVM FFI with env-stream injection (default: null stream = 0).
+    Because FA4 cute tensors carry no __tvm_ffi_env_stream__, TVM FFI does NOT
+    override the env stream during the call; so using tvm_ffi.use_raw_stream()
+    reliably steers each compiled callable onto a dedicated side stream.
+
+    Fork/join pattern (device index = `device`):
+      main_stream (null, 0) → ev_pre → s_dq / s_dkdv (concurrent) → ev_dq / ev_dkdv → main_stream
+    """
+
+    def __init__(self, compiled_dq, compiled_dkdv, device: int):
+        self._compiled_dq = compiled_dq
+        self._compiled_dkdv = compiled_dkdv
+        self._tvm_dev = _tvm_ffi.device(f"cuda:{device}")
+        self._s_dq = None
+        self._s_dkdv = None
+        self._ev_pre = None
+        self._ev_dq = None
+        self._ev_dkdv = None
+
+    def _ensure_streams(self):
+        if self._s_dq is None:
+            _, self._s_dq = cuda.cuStreamCreate(cuda.CUstream_flags.CU_STREAM_NON_BLOCKING)
+            _, self._s_dkdv = cuda.cuStreamCreate(cuda.CUstream_flags.CU_STREAM_NON_BLOCKING)
+            _, self._ev_pre = cuda.cuEventCreate(cuda.CUevent_flags.CU_EVENT_DISABLE_TIMING)
+            _, self._ev_dq = cuda.cuEventCreate(cuda.CUevent_flags.CU_EVENT_DISABLE_TIMING)
+            _, self._ev_dkdv = cuda.cuEventCreate(cuda.CUevent_flags.CU_EVENT_DISABLE_TIMING)
+
+    def __call__(self, *args):
+        self._ensure_streams()
+        # The TVM FFI env stream for this device is the "main stream" (null stream by default).
+        env_stream_ptr = _tvm_ffi.get_raw_stream(self._tvm_dev)
+        main_stream = cuda.CUstream(env_stream_ptr)
+
+        # Fork: record event on main stream, make side streams wait for it.
+        # (bwd_preprocess ran on main_stream before we were called)
+        cuda.cuEventRecord(self._ev_pre, main_stream)
+        cuda.cuStreamWaitEvent(self._s_dq, self._ev_pre, 0)
+        cuda.cuStreamWaitEvent(self._s_dkdv, self._ev_pre, 0)
+
+        # Submit dQ kernel to s_dq.
+        with _tvm_ffi.use_raw_stream(self._tvm_dev, int(self._s_dq)):
+            self._compiled_dq(*args)
+
+        # Submit dK/dV kernel to s_dkdv (concurrent with dQ).
+        with _tvm_ffi.use_raw_stream(self._tvm_dev, int(self._s_dkdv)):
+            self._compiled_dkdv(*args)
+
+        # Join: record completion events, make main stream wait for both.
+        cuda.cuEventRecord(self._ev_dq, self._s_dq)
+        cuda.cuEventRecord(self._ev_dkdv, self._s_dkdv)
+        cuda.cuStreamWaitEvent(main_stream, self._ev_dq, 0)
+        cuda.cuStreamWaitEvent(main_stream, self._ev_dkdv, 0)
+
+
